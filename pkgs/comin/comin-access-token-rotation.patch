diff --git a/internal/repository/access_token_test.go b/internal/repository/access_token_test.go
--- /dev/null
+++ b/internal/repository/access_token_test.go
@@ -0,0 +1,42 @@
+package repository
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/nlewo/comin/internal/types"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAccessTokenTracksAtomicReplacement(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "token")
+	auth := types.Auth{AccessTokenPath: path}
+	for _, value := range []string{"first-token", "rotated-token"} {
+		require.NoError(t, os.WriteFile(path+".new", []byte(value+"\n"), 0600))
+		require.NoError(t, os.Rename(path+".new", path))
+		token, err := accessToken(auth)
+		require.NoError(t, err)
+		require.Equal(t, value, token)
+	}
+}
+
+func TestAccessTokenRejectsUnavailableFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "token")
+	auth := types.Auth{AccessTokenPath: path, AccessToken: "stale-token"}
+	token, err := accessToken(auth)
+	require.Error(t, err)
+	require.Empty(t, token)
+	require.NoError(t, os.WriteFile(path, []byte(" \n"), 0600))
+	token, err = accessToken(auth)
+	require.Error(t, err)
+	require.Empty(t, token)
+}
+
+func TestAccessTokenWithoutFile(t *testing.T) {
+	for _, value := range []string{"", "configured-token"} {
+		token, err := accessToken(types.Auth{AccessToken: value})
+		require.NoError(t, err)
+		require.Equal(t, value, token)
+	}
+}
