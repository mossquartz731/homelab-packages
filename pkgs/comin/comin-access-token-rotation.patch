+func accessToken(auth types.Auth) (string, error) {
+	if auth.AccessTokenPath == "" {
+		return auth.AccessToken, nil
+	}
+	content, err := os.ReadFile(auth.AccessTokenPath)
+	if err != nil {
+		return "", fmt.Errorf("reading access token file: %w", err)
+	}
+	token := strings.TrimSpace(string(content))
+	if token == "" {
+		return "", errors.New("access token file is empty")
+	}
+	return token, nil
+}
