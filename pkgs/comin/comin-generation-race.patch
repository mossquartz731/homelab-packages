@@ -0,0 +1,106 @@
+package deployer
+
+import (
+	"context"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/nlewo/comin/internal/broker"
+	"github.com/nlewo/comin/internal/store"
+	"github.com/nlewo/comin/pkg/protobuf"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDeployerComparesLatestCompletedDeployment(t *testing.T) {
+	bk := broker.New()
+	bk.Start()
+	tmp := t.TempDir()
+	s, err := store.New(bk, tmp+"/state.json", tmp+"/gcroots", 1, 1, 1)
+	require.NoError(t, err)
+	started := make(chan string, 1)
+	finish := make(chan error, 1)
+	d := New(s, func(_ context.Context, out, _ string, _ []string, _, _ io.WriteCloser) (bool, string, error) {
+		started <- out
+		return false, "profile-path", <-finish
+	}, nil, "", bk)
+	d.Run(t.Context())
+	a := &protobuf.Generation{Uuid: "a", OutPath: "out-a"}
+	b := &protobuf.Generation{Uuid: "b", OutPath: "out-b"}
+	deploy := func(g *protobuf.Generation, failure error) {
+		t.Helper()
+		d.Submit(g, "switch", true, "")
+		select {
+		case out := <-started:
+			require.Equal(t, g.OutPath, out)
+		case <-time.After(time.Second):
+			t.Fatal("deployment did not start")
+		}
+		finish <- failure
+		select {
+		case <-d.DeploymentDoneCh:
+		case <-time.After(time.Second):
+			t.Fatal("deployment did not finish")
+		}
+	}
+	require.False(t, d.IsAlreadyDeployed(a, "switch"), "first deployment must run")
+	deploy(a, nil)
+	deploy(b, nil)
+	// Submit uses this same comparison, and manager uses it before building.
+	assert.True(t, d.IsAlreadyDeployed(b, "switch"), "A -> B -> B must skip unchanged closure")
+	assert.False(t, d.IsAlreadyDeployed(a, "switch"), "A -> B -> A must deploy revert")
+	d.Submit(b, "switch", false, "")
+	require.Nil(t, d.GenerationToDeploy, "unchanged closure must not be queued")
+	d.Submit(a, "switch", false, "")
+	select {
+	case out := <-started:
+		require.Equal(t, a.OutPath, out, "revert must reach activation")
+	case <-time.After(time.Second):
+		t.Fatal("revert did not start")
+	}
+	finish <- nil
+	<-d.DeploymentDoneCh
+	deploy(b, nil)
+	deploy(b, errors.New("activation failed"))
+	assert.False(t, d.IsAlreadyDeployed(b, "switch"), "failed activation must remain retryable")
+	d.Submit(a, "switch", true, "")
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("deployment did not start")
+	}
+	assert.False(t, d.IsAlreadyDeployed(b, "switch"), "previous closure cannot suppress a submission during activation")
+	assert.False(t, d.IsAlreadyDeployed(a, "switch"), "running activation is not yet successful")
+	finish <- nil
+	<-d.DeploymentDoneCh
+}
+
+func TestDeployerRestoredDeploymentComparison(t *testing.T) {
+	for _, tc := range []struct {
+		name, status, deployedOperation, requestedOperation string
+		want                                                bool
+	}{
+		{"successful switch", "done", "switch", "switch", true},
+		{"successful boot", "done", "boot", "boot", true},
+		{"boot must not suppress switch", "done", "boot", "switch", false},
+		{"switch must not suppress boot", "done", "switch", "boot", false},
+		{"failed", "failed", "switch", "switch", false},
+		{"running", "running", "switch", "switch", false},
+		{"initialized", "init", "switch", "switch", false},
+		{"inhibited test", "done", "null", "test", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			bk := broker.New()
+			tmp := t.TempDir()
+			s, err := store.New(bk, tmp+"/state.json", tmp+"/gcroots", 1, 1, 1)
+			require.NoError(t, err)
+			g := &protobuf.Generation{OutPath: "out-a"}
+			previous := &protobuf.Deployment{Generation: g, Operation: tc.deployedOperation, Status: tc.status}
+			d := New(s, nil, previous, "", bk)
+			require.Equal(t, tc.want, d.IsAlreadyDeployed(g, tc.requestedOperation))
+			assert.False(t, d.IsAlreadyDeployed(&protobuf.Generation{OutPath: "out-b"}, tc.requestedOperation))
+		})
+	}
+}
