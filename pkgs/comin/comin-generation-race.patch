+type generationRaceExecutor struct {
+	evalStarted  chan string
+	evalFinished chan struct{}
+	buildStarted chan struct{}
+}
+
+func (generationRaceExecutor) ReadMachineId() (string, error) { return "", nil }
+func (generationRaceExecutor) NeedToReboot(_, _ string) bool  { return false }
+func (generationRaceExecutor) IsStorePathExist(string) bool   { return false }
+func (generationRaceExecutor) Deploy(context.Context, string, string, []string, io.WriteCloser, io.WriteCloser) (bool, string, error) {
+	return false, "", nil
+}
+func (e generationRaceExecutor) Eval(ctx context.Context, source *protobuf.Source, _, _ io.WriteCloser) (string, string, string, error) {
+	select {
+	case e.evalStarted <- source.GetGit().SelectedCommitId:
+	case <-ctx.Done():
+		return "", "", "", ctx.Err()
+	}
+	select {
+	case <-e.evalFinished:
+		return "drv-path", "out-path", "", nil
+	case <-ctx.Done():
+		return "", "", "", ctx.Err()
+	}
+}
+func (e generationRaceExecutor) Build(ctx context.Context, _ string, _, _ io.WriteCloser) error {
+	e.buildStarted <- struct{}{}
+	<-ctx.Done()
+	return ctx.Err()
+}
+
+func TestManagerStopsBuildBeforeCreatingFetchedGeneration(t *testing.T) {
+	repo := utils.NewRepositoryMock()
+	tmp := t.TempDir()
+	bk := broker.New()
+	bk.Start()
+	f := fetcher.NewGitFetcher(repo, bk)
+	f.Start(t.Context())
+	s, err := store.New(bk, tmp+"/state.json", tmp+"/gcroots", 1, 1, 1)
+	assert.NoError(t, err)
+	mock := generationRaceExecutor{
+		evalStarted:  make(chan string, 2),
+		evalFinished: make(chan struct{}, 1),
+		buildStarted: make(chan struct{}, 1),
+	}
+	b := builder.New(s, mock, bk, "repoPath", "", "", "my-machine", false, 2*time.Second, 2*time.Second, 0, 30*time.Second, "")
+	defer b.Stop()
+	d := deployer.New(s, func(context.Context, string, string, []string, io.WriteCloser, io.WriteCloser) (bool, string, error) {
+		return false, "", nil
+	}, nil, "", bk)
+	bc := NewConfirmer(bk, Without, 0, "")
+	bc.Start()
+	dc := NewConfirmer(bk, Without, 0, "")
+	dc.Start()
+	m := New(s, prometheus.New(), scheduler.New(), f, b, d, "", "", mock, bc, dc, bk, emptyConfigurationOperations)
+	go m.Run(t.Context())
+
+	f.TriggerFetch([]string{"remote"})
+	repo.RsCh <- &protobuf.GitRepositoryStatus{SelectedCommitId: "first"}
+	select {
+	case commit := <-mock.evalStarted:
+		assert.Equal(t, "first", commit)
+	case <-time.After(5 * time.Second):
+		t.Fatal("first evaluation did not start")
+	}
+	mock.evalFinished <- struct{}{}
+	select {
+	case <-mock.buildStarted:
+	case <-time.After(5 * time.Second):
+		t.Fatal("first build did not start")
+	}
+
+	f.TriggerFetch([]string{"remote"})
+	repo.RsCh <- &protobuf.GitRepositoryStatus{SelectedCommitId: "second"}
+	select {
+	case commit := <-mock.evalStarted:
+		assert.Equal(t, "second", commit)
+	case <-time.After(5 * time.Second):
+		t.Fatal("second evaluation did not start after stopping the first build")
+	}
+	state := b.State()
+	assert.Equal(t, "second", state.Generation.Source.GetGit().SelectedCommitId)
+	assert.Equal(t, store.Evaluating.String(), state.Generation.EvalStatus)
+	assert.True(t, state.IsEvaluating.GetValue())
+}
