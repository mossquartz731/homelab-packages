@@ -0,0 +1,104 @@
+package deployer
+
+import (
+	"context"
+	"io"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/nlewo/comin/internal/broker"
+	"github.com/nlewo/comin/internal/store"
+	"github.com/nlewo/comin/pkg/protobuf"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDeployerQueuedRevertWins(t *testing.T) {
+	bk := broker.New()
+	bk.Start()
+	tmp := t.TempDir()
+	s, err := store.New(bk, tmp+"/state.json", tmp+"/gcroots", 1, 1, 1)
+	require.NoError(t, err)
+	started := make(chan string, 2)
+	d := New(s, func(_ context.Context, out, _ string, _ []string, _, _ io.WriteCloser) (bool, string, error) {
+		started <- out
+		return false, "", nil
+	}, nil, "", bk)
+	d.Run(t.Context())
+	a := &protobuf.Generation{Uuid: "a", OutPath: "out-a"}
+	b := &protobuf.Generation{Uuid: "b", OutPath: "out-b"}
+	d.Submit(a, "switch", false, "")
+	select {
+	case <-d.DeploymentDoneCh:
+	case <-time.After(time.Second):
+		t.Fatal("A did not finish")
+	}
+	require.Equal(t, "out-a", <-started)
+	d.Suspend("hold activation")
+	d.Submit(b, "switch", false, "")
+	require.Eventually(t, d.RunnerIsSuspended, time.Second, time.Millisecond)
+	d.Submit(a, "switch", false, "")
+	d.Submit(b, "switch", false, "")
+	d.Submit(a, "switch", false, "")
+	require.Equal(t, "out-a", d.State().GenerationToDeploy.OutPath)
+	d.Resume()
+	select {
+	case got := <-started:
+		require.Equal(t, "out-a", got, "latest requested A must replace queued B")
+	case <-time.After(time.Second):
+		t.Fatal("latest queued request did not activate")
+	}
+	select {
+	case <-d.DeploymentDoneCh:
+	case <-time.After(time.Second):
+		t.Fatal("latest queued request did not finish")
+	}
+	require.Nil(t, d.State().GenerationToDeploy)
+	select {
+	case got := <-started:
+		t.Fatalf("duplicate activation of %s", got)
+	case <-time.After(20 * time.Millisecond):
+	}
+}
+
+func TestDeployerComparisonDuringActivation(t *testing.T) {
+	previousLevel := logrus.GetLevel()
+	logrus.SetLevel(logrus.FatalLevel)
+	defer logrus.SetLevel(previousLevel)
+	bk := broker.New()
+	bk.Start()
+	tmp := t.TempDir()
+	s, err := store.New(bk, tmp+"/state.json", tmp+"/gcroots", 1, 1, 1)
+	require.NoError(t, err)
+	d := New(s, func(context.Context, string, string, []string, io.WriteCloser, io.WriteCloser) (bool, string, error) {
+		return false, "", nil
+	}, nil, "", bk)
+	d.Run(t.Context())
+	g := &protobuf.Generation{Uuid: "a", OutPath: "out-a"}
+	stop := make(chan struct{})
+	var readers sync.WaitGroup
+	for range 4 {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+					d.IsAlreadyDeployed(g, "switch")
+				}
+			}
+		}()
+	}
+	defer func() { close(stop); readers.Wait() }()
+	for range 1000 {
+		d.Submit(g, "switch", true, "")
+		select {
+		case <-d.DeploymentDoneCh:
+		case <-time.After(time.Second):
+			t.Fatal("deployment did not finish")
+		}
+	}
+}
