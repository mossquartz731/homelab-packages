+const (
+	packageRetryBackoff = time.Minute
+	packageRetrySpacing = 5 * time.Second
+)
+
+func retryPackageWebhooks(ctx context.Context, spacing time.Duration) {
+	timer := time.NewTimer(spacing)
+	defer timer.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-timer.C:
+		}
+		retryNextPackageWebhook(ctx)
+		timer.Reset(spacing)
+	}
+}
+
+func retryNextPackageWebhook(ctx context.Context) {
+	// The durable timestamp also covers a first attempt still in flight.
+	minAge := max(packageRetryBackoff, webhookHTTPClient.Timeout+packageRetrySpacing)
+	task, err := webhook_model.FindPendingPackageHookTask(ctx, time.Now().Add(-minAge))
+	if err != nil {
+		log.Error("Unable to find pending package webhook: %v", err)
+		return
+	}
+	if task != nil {
+		if err := deliver(ctx, task, true); err != nil {
+			log.Error("Unable to retry package webhook task[%d]: %v", task.ID, err)
+		}
+	}
+}
+
diff --git a/services/webhook/deliver_test.go b/services/webhook/deliver_test.go
index cf954bb..24be4e0 100644
--- a/services/webhook/deliver_test.go
+++ b/services/webhook/deliver_test.go
@@ -6,0 +7 @@ import (
+	"context"
@@ -10,0 +12 @@ import (
+	"sync/atomic"
@@ -15,0 +18,2 @@ import (
+	"gitea.dev/modules/setting"
+	"gitea.dev/modules/timeutil"
@@ -19,0 +24 @@ import (
+	"github.com/stretchr/testify/require"
@@ -21,0 +27,102 @@ import (
+func TestPackageWebhookRetriesArePacedAndRetained(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	oldSetting := setting.Webhook.RetryPackageDeliveries
+	setting.Webhook.RetryPackageDeliveries = true
+	t.Cleanup(func() { setting.Webhook.RetryPackageDeliveries = oldSetting })
+
+	var received atomic.Int64
+	var healthy atomic.Bool
+	requests := make(chan time.Time, 12)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		received.Add(1)
+		requests <- time.Now()
+		if !healthy.Load() {
+			w.WriteHeader(http.StatusServiceUnavailable)
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(server.Close)
+	ctx := t.Context()
+	hook := &webhook_model.Webhook{
+		RepoID: 3, URL: server.URL, ContentType: webhook_model.ContentTypeJSON,
+		IsActive: true, Type: webhook_module.GITEA,
+	}
+	require.NoError(t, webhook_model.CreateWebhook(ctx, hook))
+
+	publish := func() *webhook_model.HookTask {
+		task, err := webhook_model.CreateHookTask(ctx, &webhook_model.HookTask{
+			HookID: hook.ID, EventType: webhook_module.HookEventPackage,
+			PayloadVersion: 1, PayloadContent: "{}",
+		})
+		require.NoError(t, err)
+		require.Empty(t, handler(task.ID))
+		return task
+	}
+	makeDue := func(id int64, ago time.Duration) *webhook_model.HookTask {
+		task, err := webhook_model.GetHookTaskByID(ctx, id)
+		require.NoError(t, err)
+		task.Delivered = timeutil.TimeStampNano(time.Now().Add(-ago).UnixNano())
+		require.NoError(t, webhook_model.UpdateHookTask(ctx, task))
+		return task
+	}
+
+	first, second := publish(), publish()
+	require.EqualValues(t, 2, received.Load())
+	retryNextPackageWebhook(ctx)
+	require.EqualValues(t, 2, received.Load(), "fresh failures are still cooling down")
+
+	stale := makeDue(first.ID, 3*packageRetryBackoff)
+	makeDue(second.ID, 2*packageRetryBackoff)
+	for _, cleanup := range []webhook_model.HookTaskCleanupType{webhook_model.OlderThan, webhook_model.PerWebhook} {
+		require.NoError(t, webhook_model.CleanupHookTaskTable(ctx, cleanup, 0, 0))
+	}
+
+	retryNextPackageWebhook(ctx)
+	require.EqualValues(t, 3, received.Load(), "only one due task runs per interval")
+	require.NoError(t, deliver(ctx, stale, true))
+	require.EqualValues(t, 3, received.Load(), "a stale claim cannot send another request")
+
+	healthy.Store(true)
+	retryNextPackageWebhook(ctx)
+	retryNextPackageWebhook(ctx)
+	require.EqualValues(t, 4, received.Load(), "a successful delivery stops and the earlier failure cools down again")
+	acknowledged, err := webhook_model.GetHookTaskByID(ctx, second.ID)
+	require.NoError(t, err)
+	require.True(t, acknowledged.IsSucceed)
+
+	makeDue(first.ID, 2*packageRetryBackoff)
+	retryNextPackageWebhook(ctx)
+	require.EqualValues(t, 5, received.Load(), "the retained earlier delivery recovers")
+
+	healthy.Store(false)
+	makeDue(publish().ID, 3*packageRetryBackoff)
+	makeDue(publish().ID, 2*packageRetryBackoff)
+	for range 7 {
+		<-requests
+	}
+	retryCtx, cancel := context.WithCancel(ctx)
+	done := make(chan struct{})
+	const spacing = 25 * time.Millisecond
+	go func() {
+		defer close(done)
+		retryPackageWebhooks(retryCtx, spacing)
+	}()
+	defer func() {
+		cancel()
+		<-done
+	}()
+	var previous time.Time
+	for range 2 {
+		select {
+		case attempt := <-requests:
+			if !previous.IsZero() {
+				require.GreaterOrEqual(t, attempt.Sub(previous), spacing)
+			}
+			previous = attempt
+		case <-time.After(time.Second):
+			t.Fatal("timed out waiting for a paced retry")
+		}
+	}
+}
+
