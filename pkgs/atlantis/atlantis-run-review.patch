diff --git a/server/controllers/apply_controller.go b/server/controllers/apply_controller.go
new file mode 100644
index 0000000..ed5423b
--- /dev/null
+++ b/server/controllers/apply_controller.go
@@ -0,0 +1,127 @@
+// Copyright 2026 The Atlantis Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package controllers
+
+import (
+	"fmt"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/runatlantis/atlantis/server/controllers/web_templates"
+	"github.com/runatlantis/atlantis/server/events"
+	"github.com/runatlantis/atlantis/server/events/command"
+	"github.com/runatlantis/atlantis/server/events/models"
+	"github.com/runatlantis/atlantis/server/logging"
+)
+
+var lowercaseSHA = regexp.MustCompile(`^[0-9a-f]{40,64}$`)
+
+type ApplyController struct {
+	AtlantisURL          *url.URL
+	Logger               logging.SimpleLogging
+	CommandRunner        events.CommandRunner
+	RepoAllowlistChecker *events.RepoAllowlistChecker
+	GithubHostname       string
+	UserHeader           string
+	TrustedProxy         netip.Addr
+	UserMap              map[string]string
+	Template             web_templates.TemplateWriter
+}
+
+type applyRequest struct {
+	repo      models.Repo
+	pull      int
+	project   string
+	dir       string
+	workspace string
+	head      string
+	plan      string
+	actor     string
+}
+
+func ParseWebUIUserMap(value string) (map[string]string, error) {
+	result := map[string]string{}
+	for _, mapping := range strings.Split(value, ",") {
+		if strings.TrimSpace(mapping) == "" {
+			continue
+		}
+		parts := strings.Split(mapping, "=")
+		if len(parts) != 2 || strings.TrimSpace(parts[0]) == "" || strings.TrimSpace(parts[1]) == "" {
+			return nil, fmt.Errorf("invalid web UI user mapping %q", mapping)
+		}
+		result[strings.TrimSpace(parts[0])] = strings.TrimSpace(parts[1])
+	}
+	return result, nil
+}
+
+func (a *ApplyController) request(r *http.Request) (applyRequest, error) {
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil || !a.TrustedProxy.IsValid() || net.ParseIP(host) == nil || netip.MustParseAddr(host) != a.TrustedProxy {
+		return applyRequest{}, fmt.Errorf("request did not come from the trusted authentication proxy")
+	}
+	authenticated := strings.TrimSpace(r.Header.Get(a.UserHeader))
+	actor, ok := a.UserMap[authenticated]
+	if !ok {
+		return applyRequest{}, fmt.Errorf("authenticated user is not mapped to a VCS identity")
+	}
+	repoFullName := r.FormValue("repo")
+	owner, name := models.SplitRepoFullName(repoFullName)
+	pull, err := strconv.Atoi(r.FormValue("pull"))
+	if owner == "" || name == "" || pull < 1 || err != nil {
+		return applyRequest{}, fmt.Errorf("invalid repository or pull request")
+	}
+	if !a.RepoAllowlistChecker.IsAllowlisted(repoFullName, a.GithubHostname) {
+		return applyRequest{}, fmt.Errorf("repository is not allowlisted")
+	}
+	dir := r.FormValue("dir")
+	if dir == "" || filepath.Clean(dir) != dir || strings.HasPrefix(dir, "..") || strings.ContainsAny(dir, "\r\n") {
+		return applyRequest{}, fmt.Errorf("invalid project directory")
+	}
+	project := r.FormValue("project")
+	workspace := r.FormValue("workspace")
+	head := r.FormValue("head")
+	plan := r.FormValue("plan")
+	if workspace == "" || strings.ContainsAny(project+workspace, "\r\n") || !lowercaseSHA.MatchString(head) || len(head) != 40 || !lowercaseSHA.MatchString(plan) || len(plan) != 64 {
+		return applyRequest{}, fmt.Errorf("invalid saved plan identity")
+	}
+	cloneURL := fmt.Sprintf("https://%s/%s.git", a.GithubHostname, repoFullName)
+	repo := models.Repo{FullName: repoFullName, Owner: owner, Name: name, CloneURL: cloneURL, SanitizedCloneURL: cloneURL, VCSHost: models.VCSHost{Type: models.Github, Hostname: a.GithubHostname}}
+	return applyRequest{repo: repo, pull: pull, project: project, dir: dir, workspace: workspace, head: head, plan: plan, actor: actor}, nil
+}
+
+func (a *ApplyController) sameOrigin(r *http.Request) bool {
+	origin, err := url.Parse(r.Header.Get("Origin"))
+	return err == nil && origin.Scheme == a.AtlantisURL.Scheme && origin.Host == a.AtlantisURL.Host
+}
+
+func (a *ApplyController) Apply(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	w.Header().Set("Content-Security-Policy", "default-src 'self'; style-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'")
+	request, err := a.request(r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusForbidden)
+		return
+	}
+	requested := false
+	if r.Method == http.MethodPost {
+		if !a.sameOrigin(r) {
+			http.Error(w, "cross-origin apply confirmation refused", http.StatusForbidden)
+			return
+		}
+		requested = true
+		cmd := &events.CommentCommand{Name: command.Apply, ProjectName: request.project, RepoRelDir: request.dir, Workspace: request.workspace, ExpectedHeadCommit: request.head, ExpectedPlanHash: request.plan}
+		a.Logger.Info("authenticated web apply requested by %s as %s for %s#%d project %s", r.Header.Get(a.UserHeader), request.actor, request.repo.FullName, request.pull, request.project)
+		go a.CommandRunner.RunCommentCommand(request.repo, nil, nil, models.User{Username: request.actor}, request.pull, cmd)
+	}
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	if err := a.Template.Execute(w, web_templates.ApplyConfirmationData{RepoFullName: request.repo.FullName, PullNum: request.pull, ProjectName: request.project, RepoRelDir: request.dir, Workspace: request.workspace, HeadCommit: request.head, PlanHash: request.plan, Actor: request.actor, Requested: requested, CleanedBasePath: a.AtlantisURL.Path}); err != nil {
+		a.Logger.Err("rendering apply confirmation: %s", err)
+	}
+}
diff --git a/server/controllers/apply_controller_test.go b/server/controllers/apply_controller_test.go
new file mode 100644
index 0000000..54a20e5
--- /dev/null
+++ b/server/controllers/apply_controller_test.go
@@ -0,0 +1,99 @@
+// Copyright 2026 The Atlantis Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package controllers_test
+
+import (
+	"html/template"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"net/url"
+	"testing"
+	"time"
+
+	"github.com/runatlantis/atlantis/server/controllers"
+	"github.com/runatlantis/atlantis/server/events"
+	"github.com/runatlantis/atlantis/server/events/models"
+	"github.com/runatlantis/atlantis/server/logging"
+)
+
+type capturedApply struct {
+	user models.User
+	cmd  *events.CommentCommand
+}
+
+type capturingCommandRunner struct{ calls chan capturedApply }
+
+func (c *capturingCommandRunner) RunCommentCommand(_ models.Repo, _ *models.Repo, _ *models.PullRequest, user models.User, _ int, cmd *events.CommentCommand) {
+	c.calls <- capturedApply{user: user, cmd: cmd}
+}
+
+func (*capturingCommandRunner) RunAutoplanCommand(models.Repo, models.Repo, models.PullRequest, models.User) {
+}
+
+func newApplyController(t *testing.T) (*controllers.ApplyController, *capturingCommandRunner) {
+	t.Helper()
+	allowlist, err := events.NewRepoAllowlistChecker("github.com/alxleo/homelab")
+	if err != nil {
+		t.Fatal(err)
+	}
+	runner := &capturingCommandRunner{calls: make(chan capturedApply, 1)}
+	return &controllers.ApplyController{
+		AtlantisURL:          &url.URL{Scheme: "https", Host: "atlantis.example"},
+		Logger:               logging.NewNoopLogger(t),
+		CommandRunner:        runner,
+		RepoAllowlistChecker: allowlist,
+		GithubHostname:       "github.com",
+		UserHeader:           "Remote-User",
+		TrustedProxy:         netip.MustParseAddr("192.0.2.10"),
+		UserMap:              map[string]string{"alex": "alxleo"},
+		Template:             template.Must(template.New("test").Parse("{{ .Actor }} {{ .Requested }}")),
+	}, runner
+}
+
+func applyURL() string {
+	return "https://atlantis.example/apply?repo=alxleo%2Fhomelab&pull=42&project=network&dir=infrastructure%2Fterraform%2Fnetwork&workspace=default&head=1111111111111111111111111111111111111111&plan=2222222222222222222222222222222222222222222222222222222222222222"
+}
+
+func TestApplyControllerConfirmsExactPlanAsMappedUser(t *testing.T) {
+	controller, runner := newApplyController(t)
+	req := httptest.NewRequest(http.MethodPost, applyURL(), nil)
+	req.RemoteAddr = "192.0.2.10:12345"
+	req.Header.Set("Remote-User", "alex")
+	req.Header.Set("Origin", "https://atlantis.example")
+	w := httptest.NewRecorder()
+
+	controller.Apply(w, req)
+	if w.Code != http.StatusOK {
+		t.Fatalf("status = %d, body = %s", w.Code, w.Body.String())
+	}
+	select {
+	case got := <-runner.calls:
+		if got.user.Username != "alxleo" || got.cmd.ProjectName != "network" || got.cmd.ExpectedHeadCommit != "1111111111111111111111111111111111111111" || got.cmd.ExpectedPlanHash != "2222222222222222222222222222222222222222222222222222222222222222" {
+			t.Fatalf("unexpected apply: %#v", got)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("apply command was not dispatched")
+	}
+}
+
+func TestApplyControllerRefusesUntrustedProxyAndCrossOrigin(t *testing.T) {
+	controller, _ := newApplyController(t)
+	for name, request := range map[string][2]string{
+		"untrusted proxy": {"192.0.2.11:12345", "https://atlantis.example"},
+		"cross origin":    {"192.0.2.10:12345", "https://attacker.example"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			req := httptest.NewRequest(http.MethodPost, applyURL(), nil)
+			req.RemoteAddr = request[0]
+			req.Header.Set("Remote-User", "alex")
+			req.Header.Set("Origin", request[1])
+			w := httptest.NewRecorder()
+			controller.Apply(w, req)
+			if w.Code != http.StatusForbidden {
+				t.Fatalf("status = %d, want 403", w.Code)
+			}
+		})
+	}
+}
