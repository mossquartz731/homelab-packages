+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Confirm Atlantis apply</title>
+  <link rel="stylesheet" href="{{ .CleanedBasePath }}/static/css/normalize.css">
+  <link rel="stylesheet" href="{{ .CleanedBasePath }}/static/css/skeleton.css">
+  <link rel="stylesheet" href="{{ .CleanedBasePath }}/static/css/custom.css">
+</head>
+<body>
+  <main class="container" style="max-width: 760px; padding-top: 5rem">
+    {{ if .Requested }}
+    <h3>Apply requested</h3>
+    <p>Atlantis is checking the saved plan and the pull request requirements as <code>{{ .Actor }}</code>. The result will appear on the pull request.</p>
+    {{ else }}
+    <h3>Confirm saved plan</h3>
+    <table class="u-full-width">
+      <tbody>
+        <tr><th>Repository</th><td><code>{{ .RepoFullName }}</code></td></tr>
+        <tr><th>Pull request</th><td>#{{ .PullNum }}</td></tr>
+        <tr><th>Project</th><td><code>{{ if .ProjectName }}{{ .ProjectName }}{{ else }}{{ .RepoRelDir }}{{ end }}</code></td></tr>
+        <tr><th>Workspace</th><td><code>{{ .Workspace }}</code></td></tr>
+        <tr><th>Head</th><td><code>{{ slice .HeadCommit 0 12 }}</code></td></tr>
+        <tr><th>Plan</th><td><code>{{ slice .PlanHash 0 12 }}</code></td></tr>
+        <tr><th>Actor</th><td><code>{{ .Actor }}</code></td></tr>
+      </tbody>
+    </table>
+    <p>Atlantis will use the normal apply path. A changed head or plan, failed policy, missing approval, merge conflict, or divergence is refused.</p>
+    <form method="post">
+      <button class="button-primary" type="submit">Confirm &amp; apply</button>
+    </form>
+    {{ end }}
+  </main>
+</body>
+</html>
