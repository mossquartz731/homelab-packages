diff --git a/server/core/boltdb/policy_status_test.go b/server/core/boltdb/policy_status_test.go
new file mode 100644
index 0000000..0c4f8c8
--- /dev/null
+++ b/server/core/boltdb/policy_status_test.go
@@ -0,0 +1,75 @@
+package boltdb_test
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/runatlantis/atlantis/server/events/command"
+	"github.com/runatlantis/atlantis/server/events/models"
+)
+
+func TestPolicyChecksPreserveCompletedProjects(t *testing.T) {
+	b := newTestDB2(t)
+	defer b.Close()
+	pull := models.PullRequest{Num: 1, HeadCommit: "sha", BaseRepo: models.Repo{FullName: "owner/repo", VCSHost: models.VCSHost{Type: models.Github}}}
+	result := func(cmd command.Name, i int) command.ProjectResult {
+		return command.ProjectResult{Command: cmd, Workspace: "default", RepoRelDir: fmt.Sprintf("project-%d", i), ProjectName: fmt.Sprintf("project-%d", i)}
+	}
+	plans := make([]command.ProjectResult, 8)
+	policies := make([]command.ProjectResult, 8)
+	for i := range plans {
+		plans[i] = result(command.Plan, i)
+		output := "No changes. Your infrastructure matches the configuration."
+		if i == 7 {
+			output = "Plan: 1 to add, 0 to change, 0 to destroy."
+		}
+		plans[i].PlanSuccess = &models.PlanSuccess{TerraformOutput: output}
+		policies[i] = result(command.PolicyCheck, i)
+	}
+	if _, err := b.UpdatePullWithResults(pull, plans); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := b.UpdatePullWithResults(pull, policies); err != nil {
+		t.Fatal(err)
+	}
+	applied := result(command.Apply, 7)
+	applied.ApplySuccess = "applied"
+	if _, err := b.UpdatePullWithResults(pull, []command.ProjectResult{applied}); err != nil {
+		t.Fatal(err)
+	}
+	assertCompleted := func(want int) {
+		t.Helper()
+		stored, err := b.GetPullStatus(pull)
+		if err != nil {
+			t.Fatal(err)
+		}
+		completed := 0
+		for _, project := range stored.Projects {
+			if project.Status == models.PlannedNoChangesPlanStatus || project.Status == models.AppliedPlanStatus {
+				completed++
+			}
+		}
+		if completed != want {
+			t.Fatalf("completed projects = %d, want %d; stored projects: %+v", completed, want, stored.Projects)
+		}
+	}
+	assertCompleted(8)
+	if _, err := b.UpdatePullWithResults(pull, []command.ProjectResult{policies[7]}); err != nil {
+		t.Fatal(err)
+	}
+	assertCompleted(8)
+	failed := policies[0]
+	failed.Error = errors.New("policy failed")
+	if _, err := b.UpdatePullWithResults(pull, []command.ProjectResult{failed}); err != nil {
+		t.Fatal(err)
+	}
+	stored, err := b.GetPullStatus(pull)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stored.Projects[0].Status != models.ErroredPolicyCheckStatus {
+		t.Fatalf("failed policy status = %s", stored.Projects[0].Status)
+	}
+	assertCompleted(7)
+}
