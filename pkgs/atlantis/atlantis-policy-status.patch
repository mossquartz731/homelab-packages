+// PlanStatusAfterMerge preserves a completed plan when policy checks succeed.
+func (p ProjectResult) PlanStatusAfterMerge(existing models.ProjectPlanStatus) models.ProjectPlanStatus {
+	status := p.PlanStatus()
+	if p.Command != PolicyCheck && p.Command != ApprovePolicies {
+		return status
+	}
+	if status == models.ErroredPolicyCheckStatus || existing == models.PlannedPlanStatus || existing == models.ErroredPolicyCheckStatus {
+		return status
+	}
+	return existing
+}
+
+// HasWarnings returns true if any policy set output contains a Conftest warning.
+func (p ProjectResult) HasWarnings() bool {
+	if p.PolicyCheckResults == nil {
+		return false
+	}
+	return p.PolicyCheckResults.HasWarnings()
+}
